{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@/core/*": ["./src/core/*"], 
      "@/networkSecurity": ["./src/core/networkSecurity/index.ts"],
      "@/types/*": ["./src/types/*"],
      "@/renderers/*": ["./src/renderers/*"],
      "@/assetResolver": ["./src/core/assetResolver/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/discordParser": ["./src/core/discordParser/index.ts"],
    }
  },
  "include": ["src"],
}